    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "verify": "node cli/dist/index.js verify",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3"
  }
