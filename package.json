{
  "name": "founder-os-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The AI operating system for founders, CTOs, and product builders.",
  "license": "MIT",
  "homepage": "https://founderos.dev",
  "repository": {
    "type": "git",
